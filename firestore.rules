rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Strava tokens are server-only. The Firebase Admin SDK bypasses these rules.
    match /stravaTokens/{athleteId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
